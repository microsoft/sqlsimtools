{
    // Test think_time_ms with iteration-based workload (not duration_seconds).
    // Verifies think time works in both duration and iteration modes.
    "workloads": [
        {
            "queries": [
                "SELECT DB_NAME() AS DatabaseName, GETDATE() AS CheckTime"
            ],
            "threads": 2,
            "iterations": 5,
            "think_time_ms": 100
        },
        {
            "queries": [
                "SELECT 1 AS Ping"
            ],
            "threads": 1,
            "iterations": 10,
            "think_time_ms": 0
        }
    ]
}
